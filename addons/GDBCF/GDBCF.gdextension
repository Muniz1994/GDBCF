[configuration]
entry_symbol = "gdbcf_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]
windows.debug.x86_64   = "res://addons/GDBCF/bin/libgdbcf.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/GDBCF/bin/libgdbcf.windows.template_release.x86_64.dll"
linux.debug.x86_64     = "res://addons/GDBCF/bin/libgdbcf.linux.template_debug.x86_64.so"
linux.release.x86_64   = "res://addons/GDBCF/bin/libgdbcf.linux.template_release.x86_64.so"
macos.debug            = "res://addons/GDBCF/bin/libgdbcf.macos.template_debug.framework"
macos.release          = "res://addons/GDBCF/bin/libgdbcf.macos.template_release.framework"
